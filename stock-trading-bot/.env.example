# Copy this file to `.env` and fill in your own values. `.env` is gitignored - never commit it.

# ---------------------------------------------------------------------------
# Alpaca PAPER trading keys (https://app.alpaca.markets -> switch to "Paper" -> API Keys)
# The bot always connects to Alpaca's paper endpoint; live keys will not work.
# ---------------------------------------------------------------------------
ALPACA_API_KEY=your_paper_api_key
ALPACA_API_SECRET=your_paper_api_secret

# ---------------------------------------------------------------------------
# Where the bot places its trades: "alpaca" (paper) or "trading212" (practice account)
# ---------------------------------------------------------------------------
BROKER=alpaca

# Trading 212 PRACTICE account API key (Trading 212 app -> switch to Practice -> Settings -> API (Beta)).
# Only the practice server is ever used; the real-money server is refused in code.
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_BASE_URL=https://demo.trading212.com/api/v0
# Name shown in the command center's account switcher. More practice accounts can be added in the
# command center itself (account menu); each gets its own bot and its own record of the bot's shares.
TRADING212_ACCOUNT_NAME=Practice account
# Which account `python run_live.py` trades when run by hand ("default" = the keys above).
TRADING212_ACCOUNT=default

# ---------------------------------------------------------------------------
# Discord messages (python run_scheduled.py / the free GitHub Actions schedule)
# ---------------------------------------------------------------------------
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# Anyone with this link can post in the channel, so keep it secret.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Command center on a cloud server / other devices
# ---------------------------------------------------------------------------
# Password for opening the command center from phones or other computers. Required for anything
# but http://localhost on this machine.
DASHBOARD_PASSWORD=
# The web address it's reached at, e.g. https://1-2-3-4.sslip.io (set by the Oracle install script)
PUBLIC_URL=
# Show an "Update" button that pulls the latest code and restarts (only on the cloud install)
STOCKBOT_SELF_UPDATE=false

# ---------------------------------------------------------------------------
# What to trade
# ---------------------------------------------------------------------------
# Your personal watchlist (comma separated tickers)
WATCHLIST=AAPL,TSLA,MSFT,NVDA,AMZN,GOOGL,META

# Strategy to run: "sma" (plain SMA crossover) or "smart_money" (SMA + follow big traders)
STRATEGY=smart_money

# ---------------------------------------------------------------------------
# SMA crossover parameters (daily bars)
# ---------------------------------------------------------------------------
SMA_SHORT_WINDOW=20
SMA_LONG_WINDOW=50
# How often the live bot checks the market: e.g. 30M, 1H, 1D
LIVE_SLEEPTIME=30M

# ---------------------------------------------------------------------------
# Position sizing & risk controls
# ---------------------------------------------------------------------------
# Max fraction of total portfolio value in any single stock (0.10 = 10%)
MAX_POSITION_PCT=0.10
# Max number of stocks held at once
MAX_OPEN_POSITIONS=8
# Stop opening new trades for the day once the portfolio is down this much vs. the day's start
# (0.03 = 3%). Set to 0 to disable.
MAX_DAILY_LOSS_PCT=0.03
# Also sell everything when the daily loss limit is hit
LIQUIDATE_ON_DAILY_LOSS=false
# Log an alert when a watched stock moves this much in a day (percent, comma separated)
PRICE_ALERT_PCTS=5,10

# ---------------------------------------------------------------------------
# "Smart money" - who to follow (all public disclosures)
# ---------------------------------------------------------------------------
# Hedge funds / big investors via SEC 13F filings. Format: Label:CIK
FOLLOW_FUNDS=Warren Buffett (Berkshire Hathaway):1067983,Leopold Aschenbrenner (Situational Awareness):2045724,Bill Ackman (Pershing Square):1336528
# People who file SEC Form 4 insider reports. Format: Label:CIK
FOLLOW_INSIDERS=Donald J. Trump:947033,Donald Trump Jr.:2016181
# Also follow CEO open-market buys/sells in your watchlist companies (SEC Form 4)
TRACK_CEO_TRADES=true
CEO_TITLES=CEO,Chief Executive
# Also message you about other officers/directors of watchlist companies (info only, never traded on)
NOTIFY_OTHER_INSIDERS=true
# Skip insider sales made under a pre-scheduled 10b5-1 plan (they carry little information)
IGNORE_PLANNED_SALES=true

# Members of Congress to follow (comma-separated). Trades come free from Bargo
# (https://www.bargo.ai/free-apis/congress, no key). Leave FOLLOW_POLITICIANS empty to skip them.
FOLLOW_POLITICIANS=Nancy Pelosi
# Optional free Bargo key (Google sign-in, no card: https://www.bargo.ai/free-apis/dash) for more
# politicians: 1,000 trades/day instead of 100.
BARGO_API_KEY=
# Optional paid Quiver Quantitative key (https://api.quiverquant.com/pricing/); used instead of Bargo when set.
QUIVER_API_KEY=

# Optional OpenFIGI key (maps 13F CUSIPs to tickers faster): https://www.openfigi.com/api
OPENFIGI_API_KEY=
# SEC asks for a contact in the User-Agent: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=stock-trading-bot your_email@example.com

# How many days a smart-money buy/sell stays "fresh"
SIGNAL_LOOKBACK_DAYS=45
# Let tickers bought by people you follow be traded even if they are not on your watchlist
FOLLOW_EXPANDS_WATCHLIST=true
# Require the SMA trend (short > long) to agree before copying a smart-money buy
REQUIRE_SMA_CONFIRMATION=true

# ---------------------------------------------------------------------------
# Backtest
# ---------------------------------------------------------------------------
BACKTEST_START=2024-01-01
BACKTEST_END=2025-12-31
BACKTEST_BUDGET=100000
